LabCommon.initHeader({ bodySection: 'transmission-dsp', pageId: 'transmission-dsp' });
// --- Ã‰TAT ET PHYSIQUE ---
const state = { isPaused: false, time: 0 };
const phys = {
  cuivre: { attBase: 10, attKm: 0.5 },
  fibre:  { attBase: 2, attKm: 0.05 },
  radio:  { attBase: 20, attKm: 1.2 },
  sat:    { attBase: 35, attKm: 0.01 }
};

// --- DOM ELEMENTS ---
const $ = id => document.getElementById(id);
const ui = {
  dist: $('dist'), media: $('mediaType'), mod: $('modType'), baud: $('baudRate'),
  filter: $('filterType'), alpha: $('alpha'), btnPause: $('btnPlayPause'),
  vDist: $('valDist'), vSNR: $('valSNR'), vSER: $('valSER'), vSpecEff: $('valSpecEff'), vRb: $('valRb'), vAlpha: $('valAlpha'), vBaud: $('valBaud'),
  vModName: $('valModName'), kpiEbN0: $('dspEbN0'), kpiBandwidth: $('dspBandwidth'), kpiState: $('dspChannelState'), kpiStateNote: $('dspChannelNote')
};

// --- CANVAS CONTEXTS ---
const ctxConst = $('constCanvas').getContext('2d');
const ctxSpec = $('specCanvas').getContext('2d');
const ctxEye = $('eyeCanvas').getContext('2d');
const ctxTime = $('timeCanvas').getContext('2d');
const dspPresetButtons = document.querySelectorAll('[data-dsp-preset]');

const dspPresets = {
    robust: { media: 'fibre', dist: 10, mod: '2', baud: 8, filter: 'rrc', alpha: 0.2 },
    nominal: { media: 'cuivre', dist: 20, mod: '16', baud: 10, filter: 'rrc', alpha: 0.3 },
    dense: { media: 'radio', dist: 32, mod: '64', baud: 18, filter: 'rrc', alpha: 0.5 }
};

dspPresetButtons.forEach(function (button) {
    button.addEventListener('click', function () {
        const preset = dspPresets[button.dataset.dspPreset];
        if (!preset) {
            return;
        }

        ui.media.value = preset.media;
        ui.dist.value = preset.dist;
        ui.mod.value = preset.mod;
        ui.baud.value = preset.baud;
        ui.filter.value = preset.filter;
        ui.alpha.value = preset.alpha;
    });
});

// --- MATHS & UTILS ---
function randn_bm() {
    let u = 0, v = 0;
    while(u === 0) u = Math.random();
    while(v === 0) v = Math.random();
    return Math.sqrt( -2.0 * Math.log( u ) ) * Math.cos( 2.0 * Math.PI * v );
}

function sinc(x) {
    if (Math.abs(x) < 1e-6) return 1.0;
    const piX = Math.PI * x;
    return Math.sin(piX) / piX;
}

function rrc(t, alpha, Ts) {
    if (alpha === 0) return sinc(t/Ts);
    const t_norm = t / Ts;
    if (Math.abs(Math.abs(t_norm) - 1 / (4 * alpha)) < 1e-4) {
        return (alpha / Math.SQRT2) * ((1 + 2 / Math.PI) * Math.sin(Math.PI / (4 * alpha)) + (1 - 2 / Math.PI) * Math.cos(Math.PI / (4 * alpha)));
    }
    const num = Math.sin(Math.PI * t_norm * (1 - alpha)) + 4 * alpha * t_norm * Math.cos(Math.PI * t_norm * (1 + alpha));
    const den = Math.PI * t_norm * (1 - Math.pow(4 * alpha * t_norm, 2));
    return num / den;
}

// Global Mapped Symbols cache
let idealSymbols = [];

// GÃ©nÃ©rateur pseudo-alÃ©atoire fluide pour garder une forme d'onde cohÃ©rente qui dÃ©file
function getSym(idx, M) {
    let seed = Math.abs(Math.sin(idx * 12345.6789));
    return idealSymbols[Math.floor(seed * M)] || idealSymbols[0];
}

ui.btnPause.addEventListener('click', () => {
    state.isPaused = !state.isPaused;
    ui.btnPause.textContent = state.isPaused ? '▶ Reprendre' : '⏸ Pause / Mesures';
    if(state.isPaused) ui.btnPause.classList.add('paused');
    else ui.btnPause.classList.remove('paused');
});

function render() {
    if (!state.isPaused) state.time += 0.05;

    const dist = +ui.dist.value;
    const media = phys[ui.media.value];
    const M = +ui.mod.value; 
    const Rs = +ui.baud.value; 
    const filterType = ui.filter.value;
    const alpha = +ui.alpha.value;

    const bitsPerSym = Math.log2(M);
    const Rb = Rs * bitsPerSym; 
    const modNames = { 2: 'BPSK', 4: 'QPSK', 16: '16-QAM', 64: '64-QAM' };

    const attenuation = media.attBase + (dist * media.attKm);
    const SNR_dB = Math.max(0, 45 - attenuation);
    const SNR_linear = Math.pow(10, SNR_dB / 10);
    const noiseStdDev = Math.sqrt((1 / SNR_linear) / 2); 

    const bandwidth = filterType === 'rrc' ? Rs * (1 + alpha) : Rs * 10; 
    const specEff = Rb / bandwidth;
    const ebN0Db = SNR_dB + 10 * Math.log10(Math.max(bandwidth / Math.max(Rb, 0.001), 0.001));

    ui.vDist.textContent = (ui.media.value==='sat'? dist*700+35000 : dist) + " km";
    ui.vBaud.textContent = Rs + " kBd";
    ui.vAlpha.textContent = alpha.toFixed(1);
    ui.vSNR.textContent = SNR_dB.toFixed(1) + " dB";
    ui.vRb.textContent = Rb.toFixed(1) + " kbps";
    ui.vSpecEff.textContent = (filterType==='rect' ? '< ' : '') + specEff.toFixed(2) + " b/s/Hz";
    ui.vModName.textContent = modNames[M] || (M + '-QAM');
    ui.alpha.disabled = filterType !== 'rrc';

    const wC = 700, hC = 260;
    
    // Seulement effacer l'Ã©cran constellation quand Ã§a bouge (pour effet cumulatif stylÃ©)
    if (!state.isPaused) {
        ctxConst.fillStyle = 'rgba(0, 0, 0, 0.1)';
        ctxConst.fillRect(0, 0, wC, hC);
    }
    
    ctxConst.strokeStyle = 'rgba(255,255,255,0.1)';
    ctxConst.beginPath(); ctxConst.moveTo(0, hC/2); ctxConst.lineTo(wC, hC/2); ctxConst.moveTo(wC/2, 0); ctxConst.lineTo(wC/2, hC); ctxConst.stroke();

    idealSymbols = [];
    let scale = 1;
    if (M === 2) scale = 1; 
    else if (M === 4) scale = Math.sqrt(1/2); 
    else if (M === 16) scale = Math.sqrt(1/10); 
    else if (M === 64) scale = Math.sqrt(1/42); 

    const levels = Math.sqrt(M);
    for (let i = 0; i < levels; i++) {
        for (let j = 0; j < (M===2 ? 1 : levels); j++) {
            let I = (M===2) ? (i===0?-1:1) : (2 * i - levels + 1) * scale;
            let Q = (M===2) ? 0 : (2 * j - levels + 1) * scale;
            idealSymbols.push({I, Q});
            ctxConst.fillStyle = 'rgba(255,255,255,0.8)';
            ctxConst.fillRect(wC/2 + I*100 - 2, hC/2 - Q*100 - 2, 4, 4);
        }
    }

    let errors = 0;
    const numSymbols = state.isPaused ? 0 : 200; // Ne pas dessiner de nouveaux points si en pause
    ctxConst.fillStyle = SNR_dB > 15 ? 'rgba(56, 189, 248, 0.7)' : 'rgba(251, 191, 36, 0.7)'; 

    for(let k=0; k<numSymbols; k++) {
        const sym = idealSymbols[Math.floor(Math.random() * M)];
        const rx_I = sym.I + randn_bm() * noiseStdDev;
        const rx_Q = sym.Q + randn_bm() * noiseStdDev;
        ctxConst.fillRect(wC/2 + rx_I*100, hC/2 - rx_Q*100, 2, 2);

        if (M > 2) {
            if (Math.abs(rx_I - sym.I) > scale || Math.abs(rx_Q - sym.Q) > scale) errors++;
        } else {
            if (Math.sign(rx_I) !== Math.sign(sym.I)) errors++;
        }
    }
    
    // Lissage du SER pour l'affichage
    const instantSER = (errors / Math.max(1, numSymbols)) * 100;
    ui.vSER.textContent = (state.isPaused ? ui.vSER.textContent : instantSER.toFixed(2) + " %");
    ui.vSER.style.color = instantSER > 0 ? "var(--err)" : "var(--rx)";

    let channelState = 'Confortable';
    let channelNote = 'La constellation reste séparée et l’œil conserve une bonne ouverture.';

    if (SNR_dB < 10 || instantSER > 12) {
        channelState = 'Critique';
        channelNote = 'Le bruit et la densité de constellation provoquent des erreurs symboles nombreuses.';
    } else if (SNR_dB < 18 || instantSER > 2) {
        channelState = 'Sensible';
        channelNote = 'Le système fonctionne, mais une hausse de débit ou de distance réduira vite la marge.';
    }

    ui.kpiEbN0.textContent = ebN0Db.toFixed(1) + ' dB';
    ui.kpiBandwidth.textContent = bandwidth.toFixed(1) + ' kHz';
    ui.kpiState.textContent = channelState;
    ui.kpiStateNote.textContent = channelNote;

    // --- SPECTRE ---
    const wS = 700, hS = 260;
    ctxSpec.clearRect(0, 0, wS, hS);
    
    ctxSpec.strokeStyle = 'rgba(255,255,255,0.1)';
    for(let i=0; i<10; i++) {
        ctxSpec.beginPath(); ctxSpec.moveTo(0, i*(hS/10)); ctxSpec.lineTo(wS, i*(hS/10)); ctxSpec.stroke();
    }

    ctxSpec.beginPath();
    ctxSpec.strokeStyle = '#38bdf8'; // Couleur HEX explicite (--tx)
    ctxSpec.lineWidth = 2;
    
    const noiseFloorDB = -Math.max(10, SNR_dB + 10); 

    for(let x=0; x<wS; x++) {
        const f_norm = (x - wS/2) / (wS/4); 
        let psd = 0;

        if (filterType === 'rect') {
            const s = sinc(f_norm);
            psd = 10 * Math.log10(s * s + 1e-10); 
        } else {
            const absF = Math.abs(f_norm);
            if (absF <= (1 - alpha)/2) psd = 0; 
            else if (absF <= (1 + alpha)/2) {
                const val = 0.5 * (1 + Math.cos( (Math.PI / alpha) * (absF - (1-alpha)/2) ));
                psd = 10 * Math.log10(val + 1e-10);
            } else {
                psd = -100; 
            }
        }
        psd = Math.max(psd, noiseFloorDB + (Math.random()*2));
        const y = 20 - (psd / 60) * (hS - 40); 
        
        if (x===0) ctxSpec.moveTo(x, y);
        else ctxSpec.lineTo(x, y);
    }
    ctxSpec.stroke();

    // --- TIME DOMAIN & EYE DIAGRAM ---
    const wT = 700, hT = 260;
    ctxTime.clearRect(0, 0, wT, hT);
    
    ctxTime.beginPath(); 
    ctxTime.strokeStyle = '#38bdf8'; // Couleur HEX explicite I
    const pathQ = new Path2D(); 
    
    if (!state.isPaused) {
        ctxEye.fillStyle = 'rgba(0, 0, 0, 0.15)';
        ctxEye.fillRect(0, 0, wT, hT);
    }

    const pixelsPerSym = 40;
    const scrollOffset = state.time * 50; 

    for (let x = 0; x < wT; x+=2) {
        let val_I = 0, val_Q = 0;
        const t_sym = (x + scrollOffset) / pixelsPerSym;

        if (filterType === 'rect') {
            const symIdx = Math.floor(t_sym);
            const sym = getSym(symIdx, M);
            val_I = sym.I;
            val_Q = sym.Q;
        } else {
            for(let i= -4; i <= 4; i++) {
                const symIdx = Math.floor(t_sym) + i;
                const sym = getSym(symIdx, M);
                const h = rrc(t_sym - symIdx - 0.5, alpha, 1.0);
                val_I += sym.I * h;
                val_Q += sym.Q * h;
            }
        }

        val_I += randn_bm() * noiseStdDev;
        val_Q += randn_bm() * noiseStdDev;

        const yI = hT/2 - val_I * 40;
        const yQ = hT/2 - val_Q * 40;
        
        if (x===0) { ctxTime.moveTo(x, yI); pathQ.moveTo(x, yQ); }
        else { ctxTime.lineTo(x, yI); pathQ.lineTo(x, yQ); }

        if (!state.isPaused) {
            const eyeX = (t_sym % 2) * (wT / 2);
            if (eyeX <= 2 || x === 0) {
                ctxEye.beginPath(); ctxEye.moveTo(eyeX, yI);
            } else {
                ctxEye.lineTo(eyeX, yI);
                ctxEye.strokeStyle = SNR_dB > 20 ? 'rgba(16, 185, 129, 0.15)' : 'rgba(239, 68, 68, 0.15)';
                ctxEye.stroke();
                ctxEye.beginPath(); ctxEye.moveTo(eyeX, yI);
            }
        }
    }
    ctxTime.stroke();
    ctxTime.strokeStyle = '#10b981'; // Vert pour Q
    ctxTime.stroke(pathQ);

    requestAnimationFrame(render);
}

requestAnimationFrame(render);
