LabCommon.initHeader({ bodySection: 'multiplexage-e1', pageId: 'multiplexage-e1' });
  const grid = document.getElementById('grid');
  const inspTitle = document.getElementById('insp-title');
  const inspBadge = document.getElementById('insp-badge');
  const inspDesc = document.getElementById('insp-desc');
  const inspBin = document.getElementById('insp-bin');
  
  let cells = [];
  let isScanning = false;
  let scanIndex = 0;
  let scanInterval;

  // 1. Initialisation de la Grille (16 Trames x 32 IT)
  function initGrid() {
    // Ligne d'en-tÃªte (Colonnes IT)
    grid.appendChild(document.createElement('div')); // Coin vide
    for (let c = 0; c < 32; c++) {
      const colHead = document.createElement('div');
      colHead.className = 'col-header';
      colHead.textContent = c;
      grid.appendChild(colHead);
    }

    // GÃ©nÃ©ration des 16 Trames
    for (let r = 0; r < 16; r++) {
      // En-tÃªte de ligne
      const rowHead = document.createElement('div');
      rowHead.className = 'row-header';
      rowHead.textContent = `T${r}`;
      grid.appendChild(rowHead);

      for (let c = 0; c < 32; c++) {
        const cell = document.createElement('div');
        cell.className = 'cell';
        
        // DÃ©termination du type de l'IT
        let type = 'voice';
        if (c === 0) {
          type = (r % 2 === 0) ? 'fas' : 'nfas';
        } else if (c === 16) {
          type = (r === 0) ? 'vmt' : 'cas';
        }

        cell.classList.add(`c-${type}`);
        cell.dataset.trame = r;
        cell.dataset.it = c;
        cell.dataset.type = type;

        // Interaction Hover
        cell.addEventListener('mouseenter', () => updateInspector(cell));

        grid.appendChild(cell);
        cells.push(cell); // Stockage pour l'animation
      }
    }
  }

  // 2. Moteur d'Inspection (Mise Ã  jour du panneau latÃ©ral)
  function updateInspector(cell) {
    if(isScanning) return; // Ne pas perturber l'affichage si l'animation tourne

    const trame = parseInt(cell.dataset.trame);
    const it = parseInt(cell.dataset.it);
    const type = cell.dataset.type;

    inspTitle.textContent = `Trame ${trame} - IT ${it}`;
    inspBin.style.display = 'block';

    switch (type) {
      case 'fas':
        inspBadge.textContent = "FAS (Frame Alignment Signal)";
        inspBadge.style.background = "var(--fas)";
        inspDesc.innerHTML = `<strong>Mot de Verrouillage de Trame.</strong><br>Cet octet est Ã©mis sur les trames paires. Il permet au rÃ©cepteur de repÃ©rer le dÃ©but exact d'une trame de 125 Âµs au milieu du flux continu de bits.`;
        inspBin.textContent = "x 0 0 1 1 0 1 1"; // x = bit international
        break;
      case 'nfas':
        inspBadge.textContent = "NFAS (Non-FAS & Alarmes)";
        inspBadge.style.background = "var(--nfas)";
        inspDesc.innerHTML = `<strong>Mot de supervision.</strong><br>Ã‰mis sur les trames impaires. Le bit nÂ°2 est toujours Ã  '1' (pour Ã©viter d'Ãªtre confondu avec le FAS). Il contient aussi le bit 'A' pour signaler une alarme distante.`;
        inspBin.textContent = "x 1 A S S S S S";
        break;
      case 'vmt':
        inspBadge.textContent = "VMT (Verrouillage Multitrame)";
        inspBadge.style.background = "var(--vmt)";
        inspDesc.innerHTML = `<strong>Super-synchronisation.</strong><br>Uniquement dans l'IT16 de la Trame 0. Permet au rÃ©cepteur de savoir que le cycle des 16 trames (Multitrame) commence, indispensable pour dÃ©coder correctement la signalisation des voies.`;
        inspBin.textContent = "0 0 0 0 x y x x"; // y = alarme multitrame
        break;
      case 'cas':
        inspBadge.textContent = "CAS (Signalisation hors bande)";
        inspBadge.style.background = "var(--cas)";
        // Calcul des voies associÃ©es (IT16 de la trame K signale la voie K et K+15)
        const voie1 = trame; 
        const voie2 = trame + 15;
        inspDesc.innerHTML = `<strong>Signalisation Voie par Voie.</strong><br>Cet octet ne contient pas de voix, mais l'Ã©tat des tÃ©lÃ©phones (RaccrochÃ©, Sonnerie...).<br>Il gÃ¨re 2 voies simultanÃ©ment :<br>- 4 bits (a,b,c,d) pour la <b>Voie ${voie1} (IT${voie1})</b><br>- 4 bits (a,b,c,d) pour la <b>Voie ${voie2} (IT${voie2+1})</b>.`;
        inspBin.textContent = "a b c d  a b c d";
        break;
      case 'voice':
        inspBadge.textContent = "Voie Utile (Payload)";
        inspBadge.style.background = "var(--muted)";
        // Calcul du numÃ©ro de la voie tÃ©lÃ©phonique (IT1->Voie1, IT17->Voie16...)
        const numVoie = it < 16 ? it : it - 1; 
        inspDesc.innerHTML = `<strong>Ã‰chantillon de donnÃ©es.</strong><br>Contient 8 bits de voix numÃ©risÃ©e (loi A) ou de donnÃ©es informatiques pour la <b>Voie TÃ©lÃ©phonique nÂ°${numVoie}</b>.<br>Ã‰tant Ã©mis 8000 fois par seconde, son dÃ©bit est de 8000 x 8 = 64 kbit/s.`;
        
        // GÃ©nÃ©rer un octet alÃ©atoire visuel
        let randBin = "";
        for(let i=0; i<8; i++) randBin += Math.random() > 0.5 ? "1 " : "0 ";
        inspBin.textContent = randBin.trim();
        break;
    }
  }

  // 3. Animation du "Scanner" de transmission
  const btnPlay = document.getElementById('btnPlay');
  const speedRange = document.getElementById('speedRange');

  btnPlay.addEventListener('click', () => {
    if (isScanning) {
      stopScanner();
    } else {
      startScanner();
    }
  });

  function startScanner() {
    isScanning = true;
    btnPlay.textContent = "â¸ ArrÃªter la Transmission";
    btnPlay.classList.add('active');
    scanIndex = 0;
    runScannerLoop();
  }

  function stopScanner() {
    isScanning = false;
    btnPlay.textContent = "â–¶ Lancer la Transmission";
    btnPlay.classList.remove('active');
    clearTimeout(scanInterval);
    cells.forEach(c => c.classList.remove('scanning'));
  }

  function runScannerLoop() {
    if(!isScanning) return;

    // Nettoyer la case prÃ©cÃ©dente
    if (scanIndex > 0) {
      cells[scanIndex - 1].classList.remove('scanning');
    } else if (scanIndex === 0 && cells.length > 0) {
      cells[cells.length - 1].classList.remove('scanning'); // Boucle
    }

    // Activer la nouvelle case
    const currentCell = cells[scanIndex];
    currentCell.classList.add('scanning');
    
    // Mettre Ã  jour l'inspecteur pour suivre l'animation
    updateInspector(currentCell);

    // IncrÃ©menter
    scanIndex++;
    if (scanIndex >= cells.length) {
      scanIndex = 0; // Reboucler la multitrame
    }

    // Calcul de la vitesse (inversÃ© : + slider haut = + dÃ©lai bas = + rapide)
    const delay = 500 - (speedRange.value * 9); 
    scanInterval = setTimeout(runScannerLoop, delay);
  }

  // Lancement initial
  initGrid();
  updateInspector(cells[0]); // Afficher les infos de la premiÃ¨re case par dÃ©faut
