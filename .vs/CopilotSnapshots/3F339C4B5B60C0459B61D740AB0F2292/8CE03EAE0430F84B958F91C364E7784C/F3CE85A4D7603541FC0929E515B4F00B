.lab-global-header {
  max-width: 1450px;
  margin: 16px auto 0;
  padding: 0 20px;
}

.lab-global-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 16px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.28);
  background: rgba(15, 23, 42, 0.78);
  box-shadow: 0 10px 26px rgba(2, 6, 23, 0.18);
  backdrop-filter: blur(10px);
}

.lab-global-header__home {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 10px;
  text-decoration: none;
  font-weight: 700;
  color: #f8fafc;
  background: rgba(2, 6, 23, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.3);
  white-space: nowrap;
}

.lab-global-header__home:hover {
  background: rgba(30, 41, 59, 0.92);
}

.lab-global-header__brand {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  min-width: 0;
}

.lab-global-header__brand strong {
  color: #f8fafc;
  font-size: 14px;
  line-height: 1.2;
}

.lab-global-header__brand span {
  color: #cbd5e1;
  font-size: 12px;
  line-height: 1.3;
  text-align: right;
}

.lab-module-nav {
  max-width: 1450px;
  margin: 10px auto 0;
  padding: 0 20px;
}

.lab-module-nav__list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.lab-module-nav__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 9px 12px;
  border-radius: 999px;
  text-decoration: none;
  font-size: 12px;
  font-weight: 800;
  color: #e2e8f0;
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.3);
}

.lab-module-nav__link:hover {
  background: rgba(30, 41, 59, 0.96);
}

.lab-module-nav__link.active {
  color: #001018;
  background: #38bdf8;
  border-color: #38bdf8;
}

.lab-context-nav {
  max-width: 1450px;
  margin: 12px auto 0;
  padding: 0 20px;
}

.lab-context-nav__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
}

.lab-context-nav__card {
  padding: 16px;
  border-radius: 16px;
  border: 1px solid rgba(148, 163, 184, 0.26);
  background: rgba(15, 23, 42, 0.82);
  box-shadow: 0 12px 28px rgba(2, 6, 23, 0.16);
}

.lab-context-nav__card--intro {
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.18), rgba(15, 23, 42, 0.88));
}

.lab-context-nav__eyebrow {
  margin-bottom: 8px;
  color: #7dd3fc;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.lab-context-nav__title {
  margin: 0 0 10px;
  color: #f8fafc;
  font-size: 16px;
}

.lab-context-nav__text {
  margin: 0;
  color: #cbd5e1;
  font-size: 13px;
  line-height: 1.5;
}

.lab-context-nav__list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.lab-context-nav__link {
  display: block;
  padding: 10px 12px;
  border-radius: 12px;
  text-decoration: none;
  color: #e2e8f0;
  font-size: 13px;
  font-weight: 700;
  background: rgba(30, 41, 59, 0.78);
  border: 1px solid rgba(148, 163, 184, 0.26);
}

.lab-context-nav__link:hover {
  background: rgba(51, 65, 85, 0.95);
}

.lab-context-nav__link.active {
  color: #001018;
  background: #22d3ee;
  border-color: #22d3ee;
}

.lab-context-nav__link--step {
  border-left: 3px solid #38bdf8;
}

.lab-context-nav__link--bridge {
  border-left: 3px solid #10b981;
}

@media (max-width: 720px) {
  .lab-global-header {
    padding: 0 16px;
  }

  .lab-module-nav {
    padding: 0 16px;
  }

   .lab-context-nav {
    padding: 0 16px;
  }

  .lab-global-header__inner {
    flex-direction: column;
    align-items: stretch;
  }

  .lab-global-header__brand {
    align-items: flex-start;
  }

  .lab-global-header__brand span {
    text-align: left;
  }
}

.lab-preset-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0 14px;
}

.lab-preset-btn {
  padding: 9px 14px;
  border: 1px solid rgba(14, 165, 233, 0.28);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.78);
  color: #e2e8f0;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.lab-preset-btn:hover {
  transform: translateY(-1px);
  background: rgba(30, 41, 59, 0.94);
  border-color: rgba(56, 189, 248, 0.5);
}

.lab-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 12px;
  margin: 0 0 18px;
}

.lab-kpi-card {
  padding: 14px 16px;
  border-radius: 16px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  background: rgba(15, 23, 42, 0.84);
  box-shadow: 0 10px 24px rgba(2, 6, 23, 0.14);
}

.lab-kpi-label {
  margin-bottom: 8px;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.lab-kpi-value {
  color: #f8fafc;
  font-size: 22px;
  font-weight: 800;
  line-height: 1.1;
}

.lab-kpi-note {
  margin-top: 6px;
  color: #cbd5e1;
  font-size: 12px;
  line-height: 1.45;
}
