:root {
  --bg: #0f172a;
  --panel: #1e293b;
  --panel-2: #111827;
  --border: #334155;
  --text: #f8fafc;
  --muted: #94a3b8;
  --accent: #38bdf8;
  --ok: #10b981;
  --warn: #f59e0b;
  --info: #a855f7;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Segoe UI', system-ui, sans-serif;
  background: linear-gradient(180deg, #020617 0%, var(--bg) 100%);
  color: var(--text);
}

.wrap {
  max-width: 1300px;
  margin: 0 auto;
  padding: 24px;
}

header {
  margin-bottom: 24px;
  padding: 24px;
  background: rgba(30, 41, 59, 0.85);
  border: 1px solid var(--border);
  border-radius: 14px;
}

h1 {
  margin: 0 0 8px;
  font-size: 30px;
}

.subtitle {
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
  max-width: 950px;
}

.top-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  margin-bottom: 28px;
}

.panel {
  background: rgba(30, 41, 59, 0.9);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px;
}

.panel h2 {
  margin: 0 0 12px;
  font-size: 18px;
}

.panel p,
.panel li {
  color: var(--muted);
  line-height: 1.55;
}

.panel ul {
  margin: 0;
  padding-left: 18px;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  background: #0b1220;
  border: 1px solid var(--border);
  color: var(--text);
}

.sections {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.section {
  background: rgba(17, 24, 39, 0.72);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 18px;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}

.section-head h2 {
  margin: 0;
  font-size: 22px;
}

.section-head p {
  margin: 0;
  color: var(--muted);
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 14px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 230px;
}

.card h3 {
  margin: 0;
  font-size: 17px;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  font-size: 11px;
  font-weight: 700;
  padding: 5px 8px;
  border-radius: 999px;
  background: #0b1220;
  border: 1px solid var(--border);
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.tag.beginner {
  color: var(--ok);
}

.tag.intermediate {
  color: var(--warn);
}

.tag.advanced {
  color: var(--info);
}

.card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.55;
  flex-grow: 1;
}

.actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.btn {
  display: inline-block;
  text-decoration: none;
  font-weight: 700;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: #0b1220;
  color: var(--text);
}

.btn.primary {
  background: var(--accent);
  color: #001018;
  border-color: var(--accent);
}

.footer-note {
  margin-top: 24px;
  padding: 16px 18px;
  background: rgba(30, 41, 59, 0.9);
  border: 1px solid var(--border);
  border-radius: 14px;
  color: var(--muted);
  line-height: 1.6;
}

code {
  color: #7dd3fc;
  font-family: Consolas, monospace;
}

@media (max-width: 900px) {
  .top-grid {
    grid-template-columns: 1fr;
  }
}
