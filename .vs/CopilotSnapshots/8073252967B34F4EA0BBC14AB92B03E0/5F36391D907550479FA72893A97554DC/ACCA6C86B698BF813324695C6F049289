<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8" />
<title>Simulateur Expert : Mesures et Séquence Télécom</title>
<link rel="stylesheet" href="assets/css/lab-common.css" />
<style>
  :root {
    --bg: #0f172a; --panel: #1e293b; --border: #334155;
    --text: #f8fafc; --muted: #94a3b8;
    --accent: #38bdf8; --ref: #64748b;
    --err: #ef4444;
  }
  body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: var(--bg); color: var(--text);
    margin: 0; padding: 20px; font-size: 14px;
  }
  .container {
    max-width: 1400px; margin: 0 auto;
    display: grid; grid-template-columns: 400px 1fr; gap: 20px;
  }
  h1 { grid-column: 1 / -1; margin: 0 0 10px 0; font-size: 22px; border-bottom: 2px solid var(--border); padding-bottom: 10px; }
  
  .panel {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 8px; padding: 20px; display: flex; flex-direction: column; gap: 15px;
  }
  .control-group { display: flex; flex-direction: column; gap: 6px; }
  label { font-weight: 600; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; display: flex; justify-content: space-between;}
  select, input[type="range"] {
    width: 100%; padding: 10px; background: #020617; color: var(--text);
    border: 1px solid var(--border); border-radius: 4px; outline: none; font-size: 14px; box-sizing: border-box;
  }
  select:focus { border-color: var(--accent); }
  
  .symbols-container { display: flex; flex-wrap: wrap; gap: 10px; }
  .sym-input-wrapper { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .sym-label { font-size: 11px; font-weight: bold; }
  .sym-input {
    width: 60px; padding: 8px; background: #020617; color: var(--text);
    border: 2px solid var(--border); border-radius: 4px; outline: none; 
    font-size: 14px; text-align: center; font-family: monospace; font-weight: bold; transition: all 0.2s;
  }
  .sym-input:focus { transform: translateY(-2px); box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
  .sym-input.invalid { border-color: var(--err) !important; color: var(--err) !important; background: rgba(239, 68, 68, 0.1); }

  .metrics { background: #020617; padding: 15px; border-radius: 6px; border: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px; position: relative; overflow: hidden; min-height: 250px; flex-grow: 1;}
  .seq-list { display: flex; flex-direction: column; gap: 8px; overflow-y: auto; max-height: 280px; padding-right: 5px;}
  .seq-item { 
    background: rgba(255,255,255,0.02); border-left: 4px solid var(--border); 
    border-radius: 4px; padding: 10px; font-size: 13px; display: grid; grid-template-columns: 80px 1fr; gap: 10px; align-items: center;
  }
  .seq-bin { font-family: monospace; font-weight: bold; font-size: 16px; letter-spacing: 1px;}
  .seq-data { color: var(--muted); display: flex; gap: 15px; flex-wrap: wrap;}
  .seq-data span { font-weight: bold; font-family: monospace; font-size: 14px;}

  .equation-box {
    background: rgba(56, 189, 248, 0.1); border: 1px dashed var(--accent);
    padding: 10px; border-radius: 4px; text-align: center; font-family: monospace;
    font-size: 14px; color: #e0f2fe; margin-top: auto;
  }

  .metrics-overlay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(2, 6, 23, 0.95); display: flex; flex-direction: column;
    justify-content: center; align-items: center; text-align: center; padding: 20px;
    color: var(--err); font-weight: bold; font-size: 14px; z-index: 10;
  }

  .stage { display: flex; flex-direction: column; gap: 20px; }
  .view-card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 15px; position: relative;}
  .view-title { font-weight: bold; margin-bottom: 10px; font-size: 14px; color: var(--accent); }
  canvas { background: #000; border-radius: 4px; width: 100%; box-shadow: inset 0 0 15px rgba(0,0,0,0.8); }
  
  #constCanvas { aspect-ratio: 1; max-width: 400px; margin: 0 auto; display: block; }
  #timeCanvas { height: 260px; }

  .legend { display: flex; gap: 15px; font-size: 12px; justify-content: center; margin-top: 8px; color: var(--muted); }
</style>
</head>
<body>

<div class="lab-global-header">
  <div class="lab-global-header__inner">
    <a class="lab-global-header__home" href="index.html">← Accueil</a>
    <div class="lab-global-header__brand">
      <strong>Laboratoire Virtuel de Télécommunication</strong>
      <span>Modulations numériques • séquences et trajectoires I/Q</span>
    </div>
  </div>
</div>

<div class="container">
  <h1 id="pageTitle">Laboratoire : Oscilloscope & Analyseur Vectoriel (Unités de Mesure)</h1>
  
  <div class="panel">
    <div class="control-group">
      <label>1. Famille de Modulation</label>
      <select id="modType">
        <option value="ASK">ASK (Amplitude Shift Keying)</option>
        <option value="PSK" selected>PSK (Phase Shift Keying)</option>
        <option value="QAM">QAM (Quadrature Amplitude Mod.)</option>
        <option value="FSK">FSK (Frequency Shift Keying)</option>
      </select>
    </div>
    
    <div class="control-group">
      <label>2. Valence de l'Alphabet (M)</label>
      <select id="modOrder"></select>
    </div>

    <div class="control-group">
      <label id="numSymTitle"><span>3. Longueur de la séquence</span> <span id="numSymLabel" style="color:var(--accent); font-weight:bold;">4</span></label>
      <input type="range" id="numSymRange" min="1" max="10" value="4">
    </div>

    <div class="control-group">
      <label>4. Saisie des symboles (<span id="bitsPerSymLabel"></span> bits/symbole)</label>
      <div class="symbols-container" id="symbolsContainer"></div>
    </div>

    <div class="metrics">
      <div id="errorOverlay" class="metrics-overlay">
        Saisie incomplète ou non-binaire.<br>
        <span style="color:var(--muted); font-weight:normal; margin-top:5px; font-size:12px;">Veuillez remplir correctement tous les champs avec des 0 et des 1.</span>
      </div>

      <label>Décodage Exact de la Séquence</label>
      <div class="seq-list" id="seqList"></div>
      
      <div class="equation-box" id="eqBox">
        s(t) = I_k \cos(2\pi f_c t) - Q_k \sin(2\pi f_c t)
      </div>
    </div>
  </div>

  <div class="stage">
    <!-- Constellation -->
    <div class="view-card" style="display: flex; flex-direction: column;">
      <div class="view-title">Constellation I/Q (Amplitude Normalisée)</div>
      <canvas id="constCanvas" width="400" height="400"></canvas>
      <div class="legend" id="constLegend">Les flèches et les couleurs indiquent l'ordre de transition.</div>
    </div>

    <!-- Onde Temporelle -->
    <div class="view-card">
      <div class="view-title">Onde Temporelle s(t) (Amplitude vs Temps Symbole Ts)</div>
      <canvas id="timeCanvas" width="800" height="260"></canvas>
      <div class="legend">La couleur de l'onde correspond à la couleur du symbole binaire saisi.</div>
    </div>
  </div>
</div>

<script>
const SYMBOL_COLORS = ['#38bdf8', '#10b981', '#f59e0b', '#ec4899', '#a855f7', '#ef4444', '#14b8a6', '#eab308', '#6366f1', '#f43f5e'];
const modConfig = { ASK: [2, 4, 8], PSK: [2, 4, 8, 16], QAM: [4, 16, 64], FSK: [2, 4, 8] };

const els = {
  modType: document.getElementById('modType'), modOrder: document.getElementById('modOrder'),
  numSymRange: document.getElementById('numSymRange'), numSymLabel: document.getElementById('numSymLabel'),
  bitsPerSymLabel: document.getElementById('bitsPerSymLabel'), symbolsContainer: document.getElementById('symbolsContainer'),
  errorOverlay: document.getElementById('errorOverlay'), seqList: document.getElementById('seqList'),
  eqBox: document.getElementById('eqBox'), constLegend: document.getElementById('constLegend'),
  ctxConst: document.getElementById('constCanvas').getContext('2d'), ctxTime: document.getElementById('timeCanvas').getContext('2d')
};

const pageParams = new URLSearchParams(window.location.search);

function applyInitialMode() {
  const mode = pageParams.get('mode');
  const requestedCount = parseInt(pageParams.get('num') || '', 10);

  if (Number.isFinite(requestedCount) && requestedCount >= 1 && requestedCount <= 10) {
    els.numSymRange.value = requestedCount;
  }

  if (mode === 'symbol') {
    els.numSymRange.value = '1';
    els.numSymRange.disabled = true;
    document.getElementById('pageTitle').textContent = 'Laboratoire : Analyse d’un Symbole (Mode unifié)';
    document.getElementById('numSymTitle').innerHTML = '<span>3. Mode symbole unique</span> <span id="numSymLabel" style="color:var(--accent); font-weight:bold;">1</span>';
    els.numSymLabel = document.getElementById('numSymLabel');
  }
}

let mapDict = {}; let allSymbols = []; let currentSequence = []; 

function getGrayCodes(n) {
  if (n === 1) return ['0', '1'];
  const prev = getGrayCodes(n - 1);
  const result = [];
  for (let i = 0; i < prev.length; i++) result.push('0' + prev[i]);
  for (let i = prev.length - 1; i >= 0; i--) result.push('1' + prev[i]);
  return result;
}

function updateOrderOptions() {
  const type = els.modType.value;
  const currentVal = els.modOrder.value;
  els.modOrder.innerHTML = '';
  modConfig[type].forEach(m => {
    const opt = document.createElement('option');
    opt.value = m; opt.textContent = `${m} (n = ${Math.log2(m)} bits)`;
    if(m == currentVal) opt.selected = true;
    els.modOrder.appendChild(opt);
  });
  if(!els.modOrder.value) els.modOrder.value = modConfig[type][0];
  generateMapping(); generateInputFields();
}

function generateMapping() {
  const type = els.modType.value; const M = parseInt(els.modOrder.value); const n = Math.log2(M);
  mapDict = {}; allSymbols = [];
  if (type === 'QAM') {
    const L = Math.sqrt(M); const nHalf = n / 2; const gray1D = getGrayCodes(nHalf);
    for (let i = 0; i < L; i++) {
      for (let j = 0; j < L; j++) {
        const bin = gray1D[i] + gray1D[j];
        const I = (2 * i - L + 1) / (L - 1); const Q = (L - 1 - 2 * j) / (L - 1);
        const pt = { bin, I, Q, phase: Math.atan2(Q, I), amp: Math.sqrt(I*I + Q*Q), freqOffset: 0 };
        mapDict[bin] = pt; allSymbols.push(pt);
      }
    }
  } else {
    const gray = getGrayCodes(n);
    for (let idx = 0; idx < M; idx++) {
      const bin = gray[idx];
      let I = 0, Q = 0, phase = 0, amp = 0, freqOffset = 0;
      if (type === 'ASK') {
        amp = (2 * idx - M + 1) / (M - 1); I = amp; Q = 0; phase = I < 0 ? Math.PI : 0; amp = Math.abs(amp);
      } else if (type === 'PSK') {
        phase = (2 * Math.PI * idx) / M + (M > 2 ? Math.PI/M : 0);
        I = Math.cos(phase); Q = Math.sin(phase); amp = 1;
      } else if (type === 'FSK') {
        I = 1; Q = 0; amp = 1; phase = 0; freqOffset = (idx - (M - 1) / 2);
      }
      const pt = { bin, I, Q, phase, amp, freqOffset };
      mapDict[bin] = pt; allSymbols.push(pt);
    }
  }
}

function generateInputFields() {
  const numSyms = parseInt(els.numSymRange.value); const M = parseInt(els.modOrder.value); const n = Math.log2(M);
  els.numSymLabel.textContent = numSyms; els.bitsPerSymLabel.textContent = n; els.symbolsContainer.innerHTML = '';
  for(let i=0; i<numSyms; i++) {
    const color = SYMBOL_COLORS[i % SYMBOL_COLORS.length];
    const wrapper = document.createElement('div'); wrapper.className = 'sym-input-wrapper';
    const label = document.createElement('div'); label.className = 'sym-label'; label.textContent = `S${i+1}`; label.style.color = color;
    const input = document.createElement('input'); input.type = 'text'; input.className = 'sym-input'; input.maxLength = n;
    input.style.borderColor = color; input.style.color = color; input.addEventListener('input', validateAllInputs);
    wrapper.appendChild(label); wrapper.appendChild(input); els.symbolsContainer.appendChild(wrapper);
  }
  validateAllInputs();
}

function validateAllInputs() {
  const inputs = document.querySelectorAll('.sym-input'); const n = Math.log2(parseInt(els.modOrder.value));
  let allValid = true; currentSequence = [];
  inputs.forEach(input => {
    const val = input.value.trim(); const isValidBinary = /^[01]+$/.test(val);
    if (val.length !== n || !isValidBinary) { input.classList.add('invalid'); allValid = false; } 
    else { input.classList.remove('invalid'); currentSequence.push(mapDict[val]); }
  });
  if (allValid) { els.errorOverlay.style.display = "none"; updateDisplayMetrics(); drawConstellation(); drawWaveform(); } 
  else { els.errorOverlay.style.display = "flex"; currentSequence = []; drawConstellation(); drawWaveform(); }
}

els.modType.addEventListener('change', updateOrderOptions); els.modOrder.addEventListener('change', updateOrderOptions);
els.numSymRange.addEventListener('input', generateInputFields);

function formatPhase(rad) {
  let deg = Math.round(rad * (180 / Math.PI));
  if (deg < 0) deg += 360; if (deg === 360) deg = 0;
  return deg + "°";
}

function updateDisplayMetrics() {
  const type = els.modType.value; els.seqList.innerHTML = '';
  currentSequence.forEach((sym, idx) => {
    const color = SYMBOL_COLORS[idx % SYMBOL_COLORS.length]; let details = "";
    if (type === 'FSK') { details = `<div>Δf = <span style="color:${color}">${sym.freqOffset > 0 ? '+' : ''}${sym.freqOffset}</span></div>`; } 
    else {
      details = `<div>I = <span style="color:${color}">${sym.I.toFixed(2)}</span></div>
                 <div>Q = <span style="color:${color}">${sym.Q.toFixed(2)}</span></div>
                 <div>Amp = <span style="color:${color}">${sym.amp.toFixed(2)}</span></div>
                 <div>Phase = <span style="color:${color}">${formatPhase(sym.phase)}</span></div>`;
    }
    els.seqList.innerHTML += `<div class="seq-item" style="border-left-color: ${color};"><div class="seq-bin" style="color:${color}">[${sym.bin}]</div><div class="seq-data">${details}</div></div>`;
  });
  if (type === 'FSK') {
    els.eqBox.innerHTML = `s(t) = \\cos(2\\pi(f_c + \\Delta f_k)t)`;
    els.constLegend.textContent = "FSK : Axe X = Décalage de fréquence (Δf)";
  } else {
    els.eqBox.innerHTML = `s(t) = I_k \\cos(2\\pi f_c t) - Q_k \\sin(2\\pi f_c t)`;
    els.constLegend.textContent = "Trajectoire I/Q (Unités Normalisées)";
  }
}

function drawArrow(ctx, fromX, fromY, toX, toY, color) {
  const headlen = 8; const dx = toX - fromX; const dy = toY - fromY; const angle = Math.atan2(dy, dx);
  ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(fromX, fromY); ctx.lineTo(toX, toY); ctx.stroke();
  const endX = toX - 6 * Math.cos(angle); const endY = toY - 6 * Math.sin(angle);
  ctx.beginPath(); ctx.moveTo(endX, endY);
  ctx.lineTo(endX - headlen * Math.cos(angle - Math.PI / 6), endY - headlen * Math.sin(angle - Math.PI / 6));
  ctx.lineTo(endX - headlen * Math.cos(angle + Math.PI / 6), endY - headlen * Math.sin(angle + Math.PI / 6));
  ctx.fillStyle = color; ctx.fill();
}

function drawConstellation() {
  const ctx = els.ctxConst; const w = ctx.canvas.width; const h = ctx.canvas.height;
  const cx = w/2; const cy = h/2; const scale = (w/2) * 0.70; // Laisser de l'espace pour les labels
  
  ctx.clearRect(0, 0, w, h);
  const type = els.modType.value;

  // -- AJOUT: GRILLE ET GRADUATIONS --
  const ticks = [-1, -0.5, 0.5, 1];
  ctx.fillStyle = '#64748b'; ctx.font = '10px sans-serif'; 
  
  // Lignes de grille estompées
  ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
  if(type !== 'FSK') {
    ticks.forEach(val => {
      const tx = cx + val * scale; ctx.beginPath(); ctx.moveTo(tx, 0); ctx.lineTo(tx, h); ctx.stroke();
      const ty = cy - val * scale; ctx.beginPath(); ctx.moveTo(0, ty); ctx.lineTo(w, ty); ctx.stroke();
    });
  }

  // Axes Principaux
  ctx.strokeStyle = '#334155'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(0, cy); ctx.lineTo(w, cy); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(cx, 0); ctx.lineTo(cx, h); ctx.stroke();

  // Ticks et Unités
  if (type === 'FSK') {
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText("Fréquence relative (Δf)", cx, cy + 15);
  } else {
      ticks.forEach(val => {
        // Axe I
        const tx = cx + val * scale;
        ctx.beginPath(); ctx.moveTo(tx, cy - 4); ctx.lineTo(tx, cy + 4); ctx.stroke();
        ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText(val.toFixed(1), tx, cy + 8);
        // Axe Q
        const ty = cy - val * scale;
        ctx.beginPath(); ctx.moveTo(cx - 4, ty); ctx.lineTo(cx + 4, ty); ctx.stroke();
        ctx.textAlign = 'right'; ctx.textBaseline = 'middle'; ctx.fillText(val.toFixed(1), cx - 8, ty);
      });
      // Labels des Axes
      ctx.fillStyle = '#94a3b8'; ctx.font = 'bold 12px sans-serif';
      ctx.textAlign = 'left'; ctx.fillText("I (Volts Norm.)", w - 90, cy - 15);
      ctx.textAlign = 'center'; ctx.fillText("Q", cx + 15, 10);
  }
  // ----------------------------------

  // Points idéaux en arrière-plan
  allSymbols.forEach(pt => {
    const px = type === 'FSK' ? cx + pt.freqOffset * (scale / (allSymbols.length/2)) : cx + pt.I * scale;
    const py = type === 'FSK' ? cy : cy - pt.Q * scale;
    ctx.fillStyle = '#334155'; ctx.beginPath(); ctx.arc(px, py, 3, 0, 2*Math.PI); ctx.fill();
  });

  if (currentSequence.length === 0) return;

  const labelOffsets = {};

  // Traçage de la séquence
  for(let i=0; i<currentSequence.length; i++) {
    const sym = currentSequence[i];
    const color = SYMBOL_COLORS[i % SYMBOL_COLORS.length];
    
    const px = type === 'FSK' ? cx + sym.freqOffset * (scale / (allSymbols.length/2)) : cx + sym.I * scale;
    const py = type === 'FSK' ? cy : cy - sym.Q * scale;

    if (i > 0) {
      const prev = currentSequence[i-1];
      const prevColor = SYMBOL_COLORS[(i-1) % SYMBOL_COLORS.length];
      const prevX = type === 'FSK' ? cx + prev.freqOffset * (scale / (allSymbols.length/2)) : cx + prev.I * scale;
      const prevY = type === 'FSK' ? cy : cy - prev.Q * scale;
      if (Math.abs(px - prevX) > 0.5 || Math.abs(py - prevY) > 0.5) {
        let gradient = ctx.createLinearGradient(prevX, prevY, px, py);
        gradient.addColorStop(0, prevColor); gradient.addColorStop(1, color);
        drawArrow(ctx, prevX, prevY, px, py, gradient);
      }
    }

    ctx.fillStyle = color; ctx.beginPath(); ctx.arc(px, py, 6, 0, 2*Math.PI); ctx.fill();
    
    const posKey = `${Math.round(px)},${Math.round(py)}`;
    labelOffsets[posKey] = (labelOffsets[posKey] || 0) + 1;
    const verticalShift = (labelOffsets[posKey] - 1) * 14; 
    
    ctx.fillStyle = color; ctx.font = 'bold 12px sans-serif';
    ctx.shadowColor = '#0f172a'; ctx.shadowBlur = 4;
    ctx.fillText(`S${i+1}`, px + 10, py - 6 + verticalShift);
    ctx.shadowBlur = 0; 
  }
}

function drawWaveform() {
  const ctx = els.ctxTime; const w = ctx.canvas.width; const h = ctx.canvas.height; const cy = h/2;
  ctx.clearRect(0, 0, w, h);
  
  // -- AJOUT: AXE Y (AMPLITUDE) --
  const offsetX = 45; // Marge pour écrire les valeurs Y
  const plotW = w - offsetX;
  
  ctx.strokeStyle = 'rgba(255,255,255,0.1)'; ctx.lineWidth = 1;
  const ampTicks = [1, 0.5, -0.5, -1];
  ctx.fillStyle = '#64748b'; ctx.font = '10px sans-serif'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
  ampTicks.forEach(val => {
      const y = cy - val * (h/2.5);
      ctx.beginPath(); ctx.moveTo(offsetX, y); ctx.lineTo(w, y); ctx.stroke(); // Grid line
      ctx.fillText(val.toFixed(1), offsetX - 5, y); // Label
  });
  ctx.fillText("0.0", offsetX - 5, cy);
  
  // Ligne de l'Axe Y
  ctx.strokeStyle = '#334155'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(offsetX, 0); ctx.lineTo(offsetX, h); ctx.stroke();
  ctx.fillStyle = '#94a3b8'; ctx.font = 'bold 11px sans-serif'; ctx.textAlign = 'left';
  ctx.fillText("s(t)", offsetX + 5, 15);
  // --------------------------------

  if (currentSequence.length === 0) {
    ctx.fillStyle = '#334155'; ctx.fillRect(offsetX, cy, plotW, 1);
    return;
  }

  const type = els.modType.value; const numSyms = currentSequence.length; const cyclesPerSym = 4;
  
  // -- AJOUT: AXE X (TEMPS EN Ts) --
  ctx.strokeStyle = '#334155'; ctx.lineWidth = 1; ctx.setLineDash([5, 5]);
  for(let i=0; i<=numSyms; i++) {
    const xBorder = offsetX + (i / numSyms) * plotW;
    ctx.beginPath(); ctx.moveTo(xBorder, 0); ctx.lineTo(xBorder, h); ctx.stroke();
    
    // Labels de Temps
    ctx.fillStyle = '#94a3b8'; ctx.font = '10px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
    if(i===0) ctx.fillText("0", xBorder, h - 5);
    else if(i===1) ctx.fillText("Ts", xBorder, h - 5);
    else ctx.fillText(`${i}Ts`, xBorder, h - 5);
  }
  ctx.setLineDash([]);
  ctx.beginPath(); ctx.moveTo(offsetX, cy); ctx.lineTo(w, cy); ctx.stroke();
  // --------------------------------

  ctx.lineWidth = 2.5;
  for (let i = 0; i < numSyms; i++) {
    const color = SYMBOL_COLORS[i % SYMBOL_COLORS.length];
    const sym = currentSequence[i];
    ctx.strokeStyle = color; ctx.beginPath();
    
    const startX = offsetX + Math.floor((i / numSyms) * plotW);
    const endX = offsetX + Math.ceil(((i + 1) / numSyms) * plotW);
    
    for (let x = startX; x <= endX; x++) {
      if(x > w) break;
      const t = ((x - offsetX) / plotW) * numSyms; 
      let signal = 0;
      
      if (type === 'FSK') {
        const delta = sym.freqOffset * 0.5;
        signal = Math.cos(2 * Math.PI * (cyclesPerSym + delta) * t);
      } else {
        const wt = 2 * Math.PI * cyclesPerSym * t;
        signal = sym.I * Math.cos(wt) - sym.Q * Math.sin(wt);
      }
      
      const y = cy - signal * (h/2.5);
      if(x === startX) ctx.moveTo(x, y); 
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
    
    // Titre S1, S2
    ctx.fillStyle = color; ctx.font = 'bold 12px sans-serif'; ctx.textAlign = 'left';
    ctx.fillText(`S${i+1}`, startX + 8, 25);
  }
}

window.onload = () => {
  applyInitialMode();
  updateOrderOptions();
};
</script>
