.lab-global-header {
  max-width: 1450px;
  margin: 16px auto 0;
  padding: 0 20px;
}

.lab-global-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 16px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.28);
  background: rgba(15, 23, 42, 0.78);
  box-shadow: 0 10px 26px rgba(2, 6, 23, 0.18);
  backdrop-filter: blur(10px);
}

.lab-global-header__home {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 10px;
  text-decoration: none;
  font-weight: 700;
  color: #f8fafc;
  background: rgba(2, 6, 23, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.3);
  white-space: nowrap;
}

.lab-global-header__home:hover {
  background: rgba(30, 41, 59, 0.92);
}

.lab-global-header__brand {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  min-width: 0;
}

.lab-global-header__brand strong {
  color: #f8fafc;
  font-size: 14px;
  line-height: 1.2;
}

.lab-global-header__brand span {
  color: #cbd5e1;
  font-size: 12px;
  line-height: 1.3;
  text-align: right;
}

@media (max-width: 720px) {
  .lab-global-header {
    padding: 0 16px;
  }

  .lab-global-header__inner {
    flex-direction: column;
    align-items: stretch;
  }

  .lab-global-header__brand {
    align-items: flex-start;
  }

  .lab-global-header__brand span {
    text-align: left;
  }
}
