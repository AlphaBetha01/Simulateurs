<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Animation Pédagogique : Émetteur et Modulation</title>
<style>
  :root {
    --bg: #f6f8fb; --card: #ffffff; --accent: #ff764d; 
    --wave-info: #5c8aff; --wave-carrier: #94a3b8; --wave-mod: #ff9b6b;
    --text-main: #1e293b; --text-muted: #64748b;
  }
  body { font-family: 'Segoe UI', system-ui, Arial, sans-serif; background: var(--bg); margin: 0; color: var(--text-main); }
  .wrap { max-width: 1000px; margin: 20px auto; padding: 24px; background: var(--card); border-radius: 12px; box-shadow: 0 8px 30px rgba(15,30,60,0.06); }
  h1 { margin: 0 0 16px; font-size: 22px; color: #0f172a; }
  
  .controls { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; background: #f8fafc; padding: 16px; border-radius: 10px; border: 1px solid #e2e8f0; }
  .control-group { flex: 1; min-width: 200px; }
  label { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px; }
  span.val { color: var(--wave-info); font-weight: bold; }
  input[type=range] { width: 100%; cursor: pointer; accent-color: var(--wave-info); }
  
  /* Radio buttons pour AM/FM */
  .radio-group { display: flex; gap: 12px; margin-top: 6px; }
  .radio-label { display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer; font-weight: 600; color: var(--accent); }
  input[type=radio] { accent-color: var(--accent); transform: scale(1.2); cursor: pointer; }

  .stage { display: flex; flex-direction: column; gap: 16px; }
  .panel { padding: 16px; border-radius: 10px; background: #ffffff; border: 1px solid #e2e8f0; position: relative; }
  .panel.highlight { border-color: #ffd8cb; background: #fffaf8; box-shadow: inset 0 0 20px rgba(255, 155, 107, 0.05); }
  .title { font-weight: 700; font-size: 12px; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; display: flex; justify-content: space-between;}
  
  svg { width: 100%; height: 120px; display: block; overflow: visible; }
  
  /* Icône Antenne */
  .antenna { position: absolute; right: 16px; top: 16px; width: 32px; height: 32px; opacity: 0.8; }

  footer { font-size: 13px; color: var(--text-muted); margin-top: 20px; text-align: center; }
</style>
</head>
<body>

<div style="max-width:1450px;margin:16px auto 0;padding:0 24px;">
  <a href="index.html" style="display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:10px;text-decoration:none;font-weight:700;background:#ffffff;border:1px solid #e2e8f0;color:#0f172a;box-shadow:0 4px 14px rgba(15,23,42,0.06);">← Accueil du laboratoire</a>
</div>

<div class="wrap">
  <h1>Animation Pédagogique : L'Émetteur (Modulation AM / FM)</h1>
  
  <div class="controls">
    <div class="control-group">
      <label>1. Fréq. du Signal (Message) <span class="val"><span id="fInfoVal">2</span> Hz</span></label>
      <input id="fInfo" type="range" min="0.5" max="5" step="0.1" value="2">
    </div>
    <div class="control-group">
      <label>2. Fréq. de la Porteuse (Véhicule) <span class="val" style="color:var(--wave-carrier)"><span id="fPortVal">30</span> Hz</span></label>
      <input id="fPort" type="range" min="10" max="60" step="1" value="30">
    </div>
    <div class="control-group">
      <label>3. Type de Modulation</label>
      <div class="radio-group">
        <label class="radio-label"><input type="radio" name="modType" value="AM" checked> AM (Amplitude)</label>
        <label class="radio-label"><input type="radio" name="modType" value="FM"> FM (Fréquence)</label>
      </div>
    </div>
  </div>

  <div class="stage">
    <!-- Panneau 1 : Le message -->
    <div class="panel">
      <div class="title">1. Signal d'Information (Basse Fréquence) <span>La voix, les données...</span></div>
      <svg id="svgInfo" viewBox="0 0 800 120" preserveAspectRatio="none"></svg>
    </div>

    <!-- Panneau 2 : La porteuse -->
    <div class="panel">
      <div class="title">2. Onde Porteuse (Haute Fréquence) <span>Générateur local de l'émetteur</span></div>
      <svg id="svgCarrier" viewBox="0 0 800 120" preserveAspectRatio="none"></svg>
    </div>

    <!-- Panneau 3 : Le signal modulé -->
    <div class="panel highlight">
      <div class="title" style="color: var(--accent)">3. Signal Modulé transmis à l'antenne <span>Prêt à voyager !</span></div>
      <!-- Icône d'antenne pour le côté didactique -->
      <svg class="antenna" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 8a18 18 0 0 1 16 0M7 12a10 10 0 0 1 10 0M10 16a2 2 0 0 1 4 0M12 20v-4"></path>
      </svg>
      <svg id="svgMod" viewBox="0 0 800 120" preserveAspectRatio="none"></svg>
    </div>
  </div>

  <footer>Contrairement à un câble, l'air nécessite des hautes fréquences pour transporter un signal efficacement. La modulation est la solution !</footer>
</div>

<script>
// Récupération des éléments
const svgInfo = document.getElementById('svgInfo');
const svgCarrier = document.getElementById('svgCarrier');
const svgMod = document.getElementById('svgMod');

const fInfoInput = document.getElementById('fInfo');
const fPortInput = document.getElementById('fPort');
const modRadios = document.getElementsByName('modType');

const fInfoVal = document.getElementById('fInfoVal');
const fPortVal = document.getElementById('fPortVal');

// Variables de configuration
const w = 800, h = 120;
const yCenter = h / 2;
let timeOffset = 0; // Pour faire défiler les ondes (animation continue)

function draw() {
  const fInfo = +fInfoInput.value;
  const fPort = +fPortInput.value;
  
  // Mise à jour de l'affichage des valeurs
  fInfoVal.textContent = fInfo.toFixed(1);
  fPortVal.textContent = fPort;

  // Quel type de modulation est sélectionné ?
  let isAM = true;
  for (const radio of modRadios) {
    if (radio.checked) { isAM = (radio.value === 'AM'); break; }
  }

  // Avancement du temps pour faire défiler l'onde (scroll vers la gauche)
  timeOffset += 0.003; 

  let pathInfo = `M 0 ${yCenter}`;
  let pathCarrier = `M 0 ${yCenter}`;
  let pathMod = `M 0 ${yCenter}`;
  let envTop = `M 0 ${yCenter}`; // Enveloppe AM (haut)
  let envBot = `M 0 ${yCenter}`; // Enveloppe AM (bas)

  // Boucle de calcul pour chaque pixel X
  for(let x = 0; x <= w; x += 2) {
    // Le temps virtuel (on simule une fenêtre de 2 secondes)
    const t = (x / w) * 2 + timeOffset;

    // 1. Calcul du Signal d'Information (sinusoïde simple)
    const valInfo = Math.sin(2 * Math.PI * fInfo * t);
    const yInfo = yCenter - valInfo * (h * 0.4);
    pathInfo += ` L ${x} ${yInfo}`;

    // 2. Calcul de l'Onde Porteuse (sinusoïde rapide)
    const valCarrier = Math.sin(2 * Math.PI * fPort * t);
    const yCarrier = yCenter - valCarrier * (h * 0.4);
    pathCarrier += ` L ${x} ${yCarrier}`;

    // 3. Calcul du Signal Modulé
    let yMod;
    if (isAM) {
      // Modulation d'Amplitude : S(t) = (1 + m * Info) * Porteuse
      const m = 0.8; // Indice de modulation (80%)
      const amplitudeMod = (1 + m * valInfo);
      yMod = yCenter - (amplitudeMod * valCarrier * (h * 0.25));
      
      // Dessin de l'enveloppe pointillée pour l'AM (aide pédagogique)
      envTop += ` L ${x} ${yCenter - (amplitudeMod * (h * 0.25))}`;
      envBot += ` L ${x} ${yCenter + (amplitudeMod * (h * 0.25))}`;
    } else {
      // Modulation de Fréquence : S(t) = sin(2*pi*fC*t + beta * sin(2*pi*fI*t))
      const beta = 3.0; // Indice de modulation FM
      const phaseFM = 2 * Math.PI * fPort * t + beta * Math.sin(2 * Math.PI * fInfo * t);
      yMod = yCenter - Math.sin(phaseFM) * (h * 0.4);
    }
    pathMod += ` L ${x} ${yMod}`;
  }

  // Rendu SVG
  svgInfo.innerHTML = `<path d="${pathInfo}" stroke="var(--wave-info)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;
  
  svgCarrier.innerHTML = `<path d="${pathCarrier}" stroke="var(--wave-carrier)" stroke-width="2" fill="none" opacity="0.6"/>`;
  
  let modHTML = `<path d="${pathMod}" stroke="var(--wave-mod)" stroke-width="2" fill="none"/>`;
  // Ajouter les enveloppes pointillées si on est en AM
  if (isAM) {
    modHTML += `<path d="${envTop}" stroke="var(--wave-info)" stroke-width="1.5" stroke-dasharray="4 4" fill="none" opacity="0.5"/>`;
    modHTML += `<path d="${envBot}" stroke="var(--wave-info)" stroke-width="1.5" stroke-dasharray="4 4" fill="none" opacity="0.5"/>`;
  }
  svgMod.innerHTML = modHTML;

  // Boucle d'animation optimisée
  requestAnimationFrame(draw);
}

// Lancement de l'animation
requestAnimationFrame(draw);
</script>
</body>
</html>